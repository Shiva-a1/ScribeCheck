ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_VISION_MODEL=claude-sonnet-5-5
# Use each provider's cheapest current model; check their model lists.
OPENAI_MODEL=
GEMINI_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=postgresql://scribe:scribe@postgres:5432/scribe
KAFKA_BOOTSTRAP=kafka:9092

S3_BUCKET=scribe-scans
# Local MinIO. On AWS, leave both S3 endpoints empty.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-secret
AWS_REGION=us-east-1

# dev = email-only sign-in for local testing. cognito = real logins.
AUTH_MODE=dev
DEV_SECRET=replace-with-a-long-random-string-before-deploying
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
